# FloatChat Environment Variables
# Copy to .env (backend) or web/.env.local (Next.js)

# LLM provider API key (required for web chat demo)
ANTHROPIC_API_KEY=your-api-key-here

# PostgreSQL
DATABASE_URL=postgresql://floatchat:floatchat@localhost:5432/floatchat
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=floatchat
POSTGRES_USER=floatchat
POSTGRES_PASSWORD=floatchat

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERAL_MODEL=qwen2:1.5b
OLLAMA_EMBEDDING_MODEL=embeddinggemma:300m

# FastAPI backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=agentic_workflow.log

# Feature flags
ENABLE_XAI_AUDIT=true
ENABLE_PLOTTING=true
MAX_RESULTS_PER_QUERY=20
