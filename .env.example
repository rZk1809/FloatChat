# PostgreSQL connection used by the canonical Python API
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=argo_data
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<set-in-your-untracked-env-file>
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_STATEMENT_TIMEOUT_MS=15000

# ChromaDB. Leave unset to use the repository-anchored legacy path read-only.
CHROMA_PATH=
CHROMA_COLLECTION=argo_profiles_ollama

# Ollama. Set exact installed tags after reviewing docs/MODEL_SELECTION.md.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=
OLLAMA_EMBED_MODEL=

LOG_LEVEL=INFO
